QMainWindow, QWidget#centralRoot, QDialog {
    background-color: #eef1f6;
    color: #1a2332;
    font-family: "Segoe UI", "Microsoft YaHei UI", sans-serif;
    font-size: 14px;
}

QDialog#playlistDialog {
    background-color: #eef1f6;
}

QLabel { color: #1a2332; }

QLabel#titleLabel {
    font-size: 18px;
    font-weight: 600;
    color: #0d7ea8;
    letter-spacing: 0.5px;
}

QLabel#subtitleLabel { color: #5a6b7c; font-size: 12px; }

QLabel#sectionTitle {
    font-size: 14px;
    font-weight: 600;
    color: #0d7ea8;
    padding: 0;
    margin-bottom: 2px;
}

QFrame#card {
    background-color: #ffffff;
    border: 1px solid #c5d0de;
    border-radius: 8px;
    padding: 4px;
}

QGroupBox#advancedLogin {
    border: 1px solid #c5d0de;
    border-radius: 6px;
    margin-top: 12px;
    padding-top: 8px;
    color: #5a6b7c;
}

QGroupBox#advancedLogin::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 6px;
    color: #5a6b7c;
}

QLineEdit, QPlainTextEdit, QSpinBox, QComboBox {
    background-color: #fafbfc;
    border: 1px solid #b8c5d9;
    border-radius: 6px;
    padding: 8px 10px;
    color: #1a2332;
    selection-background-color: #3d8ec4;
    selection-color: #ffffff;
}

QComboBox {
    padding-right: 28px;
    min-height: 18px;
}

QLineEdit:focus, QPlainTextEdit:focus, QSpinBox:focus,
QComboBox:focus, QComboBox:on {
    border: 1px solid #0d7ea8;
}

QComboBox:hover {
    border-color: #98a8ba;
}

QComboBox:disabled {
    color: #8a9aa8;
    background-color: #eef1f6;
    border-color: #d0d8e4;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 26px;
    border: none;
    background: transparent;
}

QComboBox::down-arrow {
    image: none;
    width: 0;
    height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #6b7c8f;
}

QComboBox:hover::down-arrow {
    border-top-color: #3d5a80;
}

QComboBox:focus::down-arrow, QComboBox:on::down-arrow {
    border-top-color: #0d7ea8;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #1a2332;
    border: 1px solid #c5d0de;
    border-radius: 8px;
    padding: 6px;
    margin-top: 4px;
    selection-background-color: #d6ebf5;
    selection-color: #1a2332;
    outline: none;
}

QComboBox QAbstractItemView::item {
    min-height: 26px;
    padding: 4px 10px;
    border-radius: 4px;
    color: #1a2332;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #eef2f7;
}

QComboBox QAbstractItemView::item:selected {
    background-color: #d6ebf5;
    color: #0d4a66;
}

QPushButton {
    background-color: #e8edf4;
    border: 1px solid #b8c5d9;
    border-radius: 6px;
    padding: 8px 16px;
    color: #1a2332;
    font-weight: 500;
}

QPushButton:hover {
    border-color: #0d7ea8;
    background-color: #d6ebf5;
}

QPushButton#primaryBtn {
    background-color: #0d7ea8;
    border: 1px solid #0a6a8c;
    color: #ffffff;
}

QPushButton#primaryBtn:hover { background-color: #0a6a8c; }

QPushButton#tableActBtn {
    padding: 2px 6px;
    font-size: 12px;
    min-width: 40px;
    border-radius: 4px;
}

QPushButton#themeBtn { min-width: 88px; }

QTableWidget {
    background-color: #ffffff;
    alternate-background-color: #f4f7fb;
    border: 1px solid #c5d0de;
    border-radius: 6px;
    gridline-color: #dde4ec;
    color: #1a2332;
}

QTableWidget::item { padding: 4px; color: #1a2332; }
QTableWidget::item:selected { background-color: #d6ebf5; color: #1a2332; }

QListWidget {
    background-color: #ffffff;
    alternate-background-color: #f4f7fb;
    border: 1px solid #c5d0de;
    border-radius: 6px;
    color: #1a2332;
    padding: 4px;
    outline: none;
}

QListWidget::item {
    padding: 6px 8px;
    border-radius: 4px;
}

QListWidget::item:selected {
    background-color: #d6ebf5;
    color: #1a2332;
}

QListWidget::item:hover {
    background-color: #eef4fa;
}

QListWidget::indicator {
    width: 18px;
    height: 18px;
    border: 1px solid #b8c5d9;
    border-radius: 4px;
    background-color: #ffffff;
}

QListWidget::indicator:checked {
    background-color: #d6ebf5;
    border-color: #0d7ea8;
}

QHeaderView::section {
    background-color: #e8edf4;
    color: #1a2332;
    border: none;
    border-bottom: 1px solid #b8c5d9;
    padding: 8px;
    font-weight: 600;
}

QProgressBar {
    background-color: #e8edf4;
    border: 1px solid #b8c5d9;
    border-radius: 4px;
    text-align: center;
    color: #1a2332;
    max-height: 20px;
}

QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #5a9fd4, stop:1 #0d7ea8);
    border-radius: 3px;
}

QPlainTextEdit#logPanel {
    font-family: Consolas, "Cascadia Mono", monospace;
    font-size: 13px;
    color: #1a2332;
    background-color: #f7f9fc;
    border: 1px solid #c5d0de;
}

QCheckBox { spacing: 6px; color: #1a2332; }

QCheckBox#playlistChk {
    font-weight: 500;
    color: #1a2332;
    padding: 2px 0;
}

QSpinBox { min-width: 72px; padding-right: 4px; }

QSpinBox::up-button, QSpinBox::down-button {
    background: #e8edf4;
    border: 1px solid #b8c5d9;
    width: 20px;
}

QSpinBox::up-arrow {
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-bottom: 5px solid #3d5a80;
    width: 0;
    height: 0;
}

QSpinBox::down-arrow {
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #3d5a80;
    width: 0;
    height: 0;
}

QToolTip {
    background-color: #ffffff;
    color: #1a2332;
    border: 1px solid #b8c5d9;
    padding: 6px;
}

QTabWidget::pane {
    border: 1px solid #c5d0de;
    border-radius: 6px;
    background-color: #ffffff;
    top: -1px;
}

QTabBar::tab {
    background-color: #e8edf4;
    color: #5a6b7c;
    border: 1px solid #c5d0de;
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    padding: 8px 16px;
    margin-right: 4px;
}

QTabBar::tab:selected {
    background-color: #ffffff;
    color: #0d7ea8;
    border-color: #b8c5d9;
}

QTabBar::tab:hover:!selected {
    background-color: #eef4fa;
    color: #1a2332;
}